{% macro api_key() -%}
{% if lang == 'en-US' %}
<h4 id="apikey-title">
  API Key
  <span class="badge text-bg-danger" aria-hidden="true">Required</span>
</h4>
<p id="apikey-desc">
  The <strong>API Key</strong> issued when you
  <a class="link" href="https://www.scopus.com/signin.uri" target="_blank" rel="nofollow noopener noreferrer">
    register with Elsevier</a>
  using your <strong>academic email</strong> or through your <strong>institution</strong>.
</p>
{% else %}
<!-- cSpell:disable -->
<h4 id="apikey-title">
  Chave de API
  <span class="badge text-bg-danger" aria-hidden="true">Obrigatório</span>
</h4>
<p id="apikey-desc">
  A <strong>Chave de API</strong> emitida quando você se
  <a class="link" href="https://www.scopus.com/signin.uri" target="_blank" rel="nofollow noopener noreferrer">
    cadastra na Elsevier</a>
  usando seu <strong>e-mail acadêmico</strong> ou por meio da sua <strong>instituição</strong>.
</p>
<!-- cSpell:enable -->
{% endif %}
{%- endmacro %}


{% macro prev_survey() -%}
{% if lang == 'en-US' %}
<h4 id="prevsurvey-title">Previous Survey</h4>
<p id="prevsurvey-desc">
  To retrieve the
  <abbr data-bs-toggle="tooltip" data-bs-title="Comma-separated Values" lang="en-US">CSV</abbr>
  from a <strong>previous survey</strong> that may still be <strong>stored</strong>, enter your <strong>API key</strong>
  and try <strong>downloading it again</strong>.
</p>
{% else %}
<!-- cSpell:disable -->
<h4 id="prevsurvey-title">Busca anterior</h4>
<p id="prevsurvey-desc">
  Para recuperar o arquivo
  <abbr data-bs-toggle="tooltip" data-bs-title="Comma-separated Values" lang="en-US">CSV</abbr>
  de uma <strong>busca anterior</strong> que ainda possa estar <strong>armazenado</strong>, insira sua <strong>Chave de
    API</strong> e tente <strong>baixá-lo
    novamente</strong>.
</p>
<!-- cSpell:enable -->
{% endif %}
{%- endmacro %}


{% macro date_range() -%}
{% if lang == 'en-US' %}
<h4 id="date-title">
  Date
  <span class="badge text-bg-secondary" aria-hidden="true">Optional</span>
</h4>
<p id="date-desc">
  The <strong>range of years</strong> of the documents' <strong>published date</strong>, from the <strong>last fifteen
    years</strong> to the <strong>current year</strong>. <strong>Default to the last three years</strong>.
</p>
{% else %}
<!-- cSpell:disable -->
<h4 id="date-title">
  Data
  <span class="badge text-bg-secondary" aria-hidden="true">Opcional</span>
</h4>
<p id="date-desc">
  O <strong>intervalo de anos</strong> da <strong>data de publicação</strong> dos documentos, dos <strong>últimos quinze
    anos</strong> até o <strong>ano atual</strong>. <strong>Últimos três anos por padrão</strong>.
</p>
<!-- cSpell:enable -->
{% endif %}
{%- endmacro %}


