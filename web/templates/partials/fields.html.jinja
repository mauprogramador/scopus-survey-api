{% macro pages() -%}
{% if lang == 'en-US' %}
<h4 id="pages-title">
  Pages
  <span class="badge text-bg-secondary" aria-hidden="true">Optional</span>
</h4>
<p id="pages-desc">
  The documents' <strong>size</strong> by <strong>page count</strong>.
</p>
{% else %}
<!-- cSpell:disable -->
<h4 id="pages-title">
  Páginas
  <span class="badge text-bg-secondary" aria-hidden="true">Opcional</span>
</h4>
<p id="pages-desc">
  O <strong>tamanho</strong> dos documentos pelo <strong>número de páginas</strong>.
</p>
<!-- cSpell:enable -->
{% endif %}
{%- endmacro %}


{% macro keywords() -%}
{% if lang == 'en-US' %}
<h4 id="keywords-title">
  Keywords
  <span class="badge text-bg-danger" aria-hidden="true">Required</span>
</h4>
<p id="keywords-desc">
  The keywords in the documents you are searching for. Enter <strong>at least two</strong> (<strong>required</strong>),
  that must be <strong>written in English</strong> and may contain <strong>hyphens</strong>,
  <strong>underscores</strong>,
  <a class="link" href="https://dev.elsevier.com/sc_search_tips.html" target="_blank"
    rel="help nofollow noopener noreferrer"><strong>phrases</strong>, <strong>wildcards</strong>, and the
    <strong>Boolean operators OR and AND NOT</strong></a>.
</p>
{% else %}
<!-- cSpell:disable -->
<h4 id="keywords-title">
  Palavras-chave
  <span class="badge text-bg-danger" aria-hidden="true">Obrigatório</span>
</h4>
<p id="keywords-desc">
  As palavras-chave presentes nos documentos que você está procurando. Insira <strong>pelo menos duas</strong>
  (<strong>obrigatórias</strong>), que devem ser <strong>escritas em inglês</strong> e podem conter
  <strong>hífens</strong>, <strong>sublinhados</strong>,
  <a class="link" href="https://dev.elsevier.com/sc_search_tips.html" target="_blank"
    rel="help nofollow noopener noreferrer"><strong>frases</strong>, <strong>caracteres curinga</strong> e os
    <strong>operadores Booleanos OR e AND NOT</strong></a>.
</p>
<!-- cSpell:enable -->
{% endif %}
{%- endmacro %}


{% macro combination() -%}
{% if lang == 'en-US' %}
<h4 id="combination-title">
  Combination
  <span class="badge text-bg-danger" aria-hidden="true">Required</span>
</h4>
<p id="combination-desc">
  The keyword <strong>combination option</strong> that best suits you to <strong>refine the survey scope</strong> based
  on the <strong>total</strong> of documents found for <strong>all possible keyword combinations</strong>.
</p>
{% else %}
<!-- cSpell:disable -->
<h4 id="combination-title">
  Combinação
  <span class="badge text-bg-danger" aria-hidden="true">Obrigatório</span>
</h4>
<p id="combination-desc">
  A <strong>opção de combinação</strong> de palavras-chave que melhor se adequa às suas necessidades para
  <strong>refinar o escopo da busca</strong> com base no <strong>total</strong> de documentos encontrados para
  <strong>todas as combinações de palavras-chave possíveis</strong>.
</p>
<!-- cSpell:enable -->
{% endif %}
{%- endmacro %}


{% macro quotas() -%}
{% if lang == 'en-US' %}
<h4 id="quotas-title">Quotas</h4>
<p id="quotas-desc">
  The <strong>maximum number of requests by API Key</strong>, with the <strong>Search</strong> and <strong>Abstract
    Retrieval</strong> APIs with a
  <a class="link" href="https://dev.elsevier.com/api_key_settings.html" target="_blank"
    rel="help nofollow noopener noreferrer">weekly quota of 20,000 and 10,000</a>,
  respectively.
</p>
{% else %}
<!-- cSpell:disable -->
<h4 id="quotas-title">Cotas</h4>
<p id="quotas-desc">
  O <strong>número máximo de requisições por chave de API</strong>, com as APIs <strong>Search</strong> e
  <strong>Abstract Retrieval</strong> tendo uma
  <a class="link" href="https://dev.elsevier.com/api_key_settings.html" target="_blank"
    rel="help nofollow noopener noreferrer">cota semanal de 20,000 e 10,000</a>,
  respectivamente.
</p>
<!-- cSpell:enable -->
{% endif %}
{%- endmacro %}


{% macro threshold() -%}
{% if lang == 'en-US' %}
<h4 id="threshold-title">
  Similarity Threshold
  <span class="badge text-bg-secondary" aria-hidden="true">Optional</span>
</h4>
<p id="threshold-desc">
  The value, <strong>from 0 to 100</strong>, used to filter documents with the <strong>same
    author(s) and similar titles</strong>, keeping <strong>the most recent one</strong>.
  <strong>Default to 80</strong>.
</p>
{% else %}
<!-- cSpell:disable -->
<h4 id="threshold-title">
  Similarity Threshold
  <span class="badge text-bg-secondary" aria-hidden="true">Optional</span>
</h4>
<p id="threshold-desc">
  O valor, <strong>de 0 a 100</strong>, usado para filtrar documentos com <strong>o(s) mesmo(s) autor(es) e títulos
    semelhantes</strong>, mantendo <strong>o mais recente</strong>. <strong>Valor 80 por padrão</strong>.
</p>
<!-- cSpell:enable -->
{% endif %}
{%- endmacro %}
